# Server Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# Database Configuration
DATABASE_URL=postgresql://dms_user:dms_password@localhost:5432/dms_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dms_db
DB_USER=dms_user
DB_PASSWORD=dms_password

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=change-this-access-secret-in-production-min-32-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Admin Seed User
ADMIN_EMAIL=admin@docmanager.com
ADMIN_PASSWORD=PdAdmin
ADMIN_NAME=System Administrator